[Unit]
Description=Yuqing RSSHub (F21 hot topics feed adapter)
After=network.target

[Service]
Type=simple
# 低权专用用户（deploy.sh 创建）；RSSHub 是公开代理型服务，绝不能以 root 跑
User=yuqing
Group=yuqing
WorkingDirectory=/opt/rsshub
# 只绑 loopback：仅 yuqing-server 本机访问，绝不暴露公网（部署后 ss -tlnp 复核）
ExecStart=/usr/bin/node /opt/rsshub/dist/index.mjs
Environment=PORT=1200
Environment=NODE_ENV=production
# RSSHub 官方 start 脚本同款参数（大响应头场景）
Environment=NODE_OPTIONS=--max-http-header-size=32768
# 可选：REDIS 连接复用现有 Redis 做路由缓存（有界内存）
# Environment=REDIS_URL=redis://127.0.0.1:6379/
Restart=on-failure
RestartSec=5
# 内存保命线：OOM 时被杀的是 rsshub 而不是 PostgreSQL
MemoryHigh=700M
MemoryMax=900M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
