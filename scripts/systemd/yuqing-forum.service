[Unit]
Description=Pangu forum engine — 多 Agent 辩论协调
After=network.target

[Service]
Type=simple
User=yuqing
WorkingDirectory=/opt/pangu-source
Environment="PYTHONPATH=/opt/pangu-source"
# Bocha API Key 等运行时变量（可选文件，缺失不报错）
EnvironmentFile=-/opt/yuqing/config/engines.env
ExecStart=/opt/yuqing/engines/venv/bin/uvicorn engines.forum_engine.main:app --host 127.0.0.1 --port 8004
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
