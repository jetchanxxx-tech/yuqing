[Unit]
Description=yuqing background worker
After=network.target postgresql.service redis-server.service yuqing-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=yuqing
WorkingDirectory=/opt/yuqing
ExecStart=/opt/yuqing/bin/yuqing-worker
Restart=always
RestartSec=5
Environment=YUGING_CONFIG=/opt/yuqing/config/config.yaml

[Install]
WantedBy=multi-user.target
