[Unit]
Description=Pangu media engine — 多模态内容理解
After=network.target

[Service]
Type=simple
User=yuging
WorkingDirectory=/opt/pangu-source
Environment="PYTHONPATH=/opt/pangu-source"
# Bocha API Key 等运行时变量（可选文件，缺失不报错）
EnvironmentFile=-/opt/yuging/config/engines.env
ExecStart=/opt/yuging/engines/venv/bin/uvicorn engines.media_engine.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
