platform/bin/
web/dist/
web/node_modules/
engines/venv/
*.tar.gz

# ── 运行时数据 ─────────────────────────────────────────
data/
logs/
*.log

# ── 编辑器 / 系统 ──────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Python 编译产物 ──────────────────────────────────
__pycache__/
*.pyc
*.pyo
